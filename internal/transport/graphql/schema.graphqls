scalar Time

type Subscription {
  commentAdded(postId: ID!): Comment!
}

type Query {
  posts(first: Int! = 20, after: String): PostPage!
  post(id: ID!): Post
}

type Mutation {
  createPost(input: CreatePostInput!): Post!
  addComment(input: AddCommentInput!): Comment!
  disableComments(postId: ID!): Post!
}

type User {
  id: ID!
  name: String!
}

type Post {
  id: ID!
  title: String!
  content: String!
  author: User!
  commentsPermitted: Boolean!
  createdAt: Time!
  comments(first: Int! = 20, after: String): CommentPage!
}

type Comment {
  id: ID!
  content: String!
  author: User!
  createdAt: Time!
  replies(first: Int! = 20, after: String): CommentPage!
}

input CreatePostInput {
  title: String!
  content: String!
}

input AddCommentInput {
  postId: ID!
  parentCommentId: ID
  content: String!
}

type PostPage {
  nodes: [Post!]!
  pageInfo: PageInfo!
}

type CommentPage {
  nodes: [Comment!]!
  pageInfo: PageInfo!
}

type PageInfo {
  endCursor: String
  hasNextPage: Boolean!
}
